<Window x:Class="UninstallerTool.Views.Dialogs.DiskSpaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disk Space Usage"
        Width="760"
        Height="640"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Disk space usage analysis" Style="{StaticResource SectionTitleText}" />

        <StackPanel x:Name="StatRow" Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Top 10 largest programs" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="2,0,0,8" />
                <ListBox x:Name="TopList" Grid.Row="1" Style="{StaticResource ListPanel}" />
                <TextBlock x:Name="MeasureLabel" Grid.Row="2" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,0" Text="Measuring folder sizes…" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,14,0,0" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Usage by publisher" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" Margin="2,0,0,8" />
                <ListBox x:Name="PublisherList" Grid.Row="1" Style="{StaticResource ListPanel}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" Style="{StaticResource DialogButtonPrimary}" IsDefault="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
