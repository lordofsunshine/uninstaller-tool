<UserControl x:Class="UninstallerTool.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260">
    <Border Style="{StaticResource CardBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <TextBlock x:Name="Placeholder"
                       Text="Select a program&#10;to see its details"
                       FontSize="13"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap" />

            <Grid x:Name="ContentRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ProgramName"
                           Grid.Row="0"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="PUBLISHER" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="PublisherValue" Style="{StaticResource ValueText}" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="VERSION" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="VersionValue" Style="{StaticResource ValueText}" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="INSTALLED" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="InstalledValue" Style="{StaticResource ValueText}" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock Text="SIZE" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="SizeValue" Style="{StaticResource ValueText}" Margin="0,1,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,14,0,0">
                    <TextBlock Text="LOCATION" Style="{StaticResource CaptionText}" />
                    <TextBlock x:Name="LocationValue" Style="{StaticResource ValueText}" Margin="0,1,0,0" />
                </StackPanel>

                <Grid Grid.Row="7" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewButton"
                            Grid.Column="0"
                            Content="Preview files"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,9"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                    <Button x:Name="InfoButton"
                            Grid.Column="1"
                            Content="More info"
                            Style="{StaticResource SecondaryButton}"
                            Padding="10,9"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
