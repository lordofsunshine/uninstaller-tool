<Window x:Class="UninstallerTool.Views.Dialogs.FilePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="840"
        Height="640"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Files in the program folder" Style="{StaticResource SectionTitleText}" />

        <TextBlock Grid.Row="1"
                   Text="Preview only. The program's own uninstaller decides what is actually removed."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0,6,0,0" />

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <ListBox x:Name="FileList" Style="{StaticResource ListPanel}" Visibility="Collapsed" />
            <TextBlock x:Name="LoadingLabel"
                       Text="Scanning the program folder…"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="0,14,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CountLabel"
                           Grid.Column="0"
                           Text="Files found: —"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="SizeLabel"
                           Grid.Column="1"
                           Text="Total size: —"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel scan"
                    Style="{StaticResource DialogButtonSecondary}"
                    Click="OnCancelClick" />
            <Button x:Name="CloseButton"
                    Content="Close"
                    Style="{StaticResource DialogButtonSecondary}"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
