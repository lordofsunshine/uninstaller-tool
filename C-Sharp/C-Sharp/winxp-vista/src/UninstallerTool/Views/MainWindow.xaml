<Window x:Class="UninstallerTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UninstallerTool.Controls"
        xmlns:views="clr-namespace:UninstallerTool.Views"
        Title="Uninstaller Tool"
        Width="1040"
        Height="700"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app_icon.ico"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ProgressStrip x:Name="Progress"
                                Grid.Row="0"
                                Height="4"
                                Margin="0,0,0,12"
                                IsIndeterminate="{Binding ProgressIndeterminate}"
                                Value="{Binding ProgressValue}"
                                Maximum="{Binding ProgressMaximum}"
                                Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Uninstaller Tool" Style="{StaticResource AppTitleText}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}" Margin="0,2,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource VersionBadge}">
                <TextBlock x:Name="VersionText" Style="{StaticResource BadgeText}" />
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SearchBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource SearchField}"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="SearchPlaceholder"
                               Grid.Column="0"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="14"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="Search programs…" />
                    <Button x:Name="ClearSearchButton"
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="OnClearSearchClick">
                        <Path Data="M0,0 L9,9 M9,0 L0,9"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <ComboBox x:Name="SortCombo"
                      Grid.Column="1"
                      Width="160"
                      Margin="10,0,0,0"
                      Style="{StaticResource SortComboBox}"
                      SelectionChanged="OnSortChanged">
                <ComboBoxItem Content="Name" />
                <ComboBoxItem Content="Size" />
                <ComboBoxItem Content="Install Date" />
                <ComboBoxItem Content="Publisher" />
            </ComboBox>

            <Button x:Name="DiskButton"
                    Grid.Column="2"
                    Content="Disk usage"
                    Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnDiskUsageClick" />

            <Button x:Name="RefreshButton"
                    Grid.Column="3"
                    Content="Refresh"
                    Margin="10,0,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnRefreshClick" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition x:Name="DetailsColumn" Width="300" MinWidth="260" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ProgramList"
                     Grid.Column="0"
                     Style="{StaticResource ProgramList}"
                     SelectionMode="Single"
                     SelectionChanged="OnSelectionChanged"
                     KeyDown="OnProgramListKeyDown"
                     PreviewMouseRightButtonDown="OnProgramListRightButtonDown">
                <ListBox.ContextMenu>
                    <ContextMenu x:Name="ProgramMenu">
                        <MenuItem Header="Program Information" Click="OnMenuInfoClick" />
                        <MenuItem Header="Preview files" Click="OnMenuPreviewClick" />
                        <Separator />
                        <MenuItem Header="Uninstall" Click="OnMenuUninstallClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="False"
                          ResizeBehavior="PreviousAndNext" />

            <views:DetailsPanel x:Name="Details" Grid.Column="2" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />

            <CheckBox x:Name="SilentCheck"
                      Grid.Column="1"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Content="Silent mode"
                      Style="{StaticResource SilentCheckBox}"
                      Checked="OnSilentChanged"
                      Unchecked="OnSilentChanged"
                      ToolTip="Ask uninstallers to run without interactive prompts when possible" />

            <Button x:Name="UninstallButton"
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    MinWidth="190"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnUninstallClick">
                <StackPanel Orientation="Horizontal">
                    <Path Width="18"
                          Height="18"
                          Margin="0,0,8,0"
                          Stretch="Uniform"
                          Stroke="White"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="M3,6 H21 M19,6 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V6 M8,6 V4 A2,2 0 0 1 10,2 H14 A2,2 0 0 1 16,4 V6 M10,11 V17 M14,11 V17" />
                    <TextBlock Text="Uninstall selected"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
